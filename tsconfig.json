{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  // Solo el código de navegador. `api/` son funciones serverless de Node (otro
  // runtime, otras deps: firebase-admin, crypto) y las tipa el host que las sirva.
  "include": [
    "*.ts",
    "*.tsx",
    "1-detection/**/*",
    "2-gateway/**/*",
    "3-delivery/**/*",
    "lib/**/*",
    "types/**/*"
  ]
}
